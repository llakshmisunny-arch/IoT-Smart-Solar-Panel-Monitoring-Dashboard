<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IoT Smart Solar Panel Monitoring Dashboard</title>
    <!-- Chart.js CDN for dynamic live graphing -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        :root {
            --bg-color: #0b0f19;
            --card-bg: #151c2c;
            --accent-yellow: #f59e0b;
            --accent-blue: #38bdf8;
            --accent-green: #10b981;
            --accent-red: #ef4444;
            --text-color: #f1f5f9;
            --text-sub: #94a3b8;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 20px;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #1e293b;
            padding-bottom: 15px;
            margin-bottom: 25px;
        }

        h1 {
            margin: 0;
            font-size: 1.6rem;
            color: var(--accent-yellow);
        }

        .connection-badge {
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: bold;
            background-color: var(--accent-green);
            color: #000;
        }

        /* Metrics Cards Grid */
        .metrics-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 25px;
        }

        .card {
            background-color: var(--card-bg);
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.4);
            border-top: 4px solid var(--accent-blue);
        }

        .card.power { border-top-color: var(--accent-yellow); }
        .card.temp { border-top-color: var(--accent-red); }
        .card.efficiency { border-top-color: var(--accent-green); }

        .card-title {
            font-size: 0.8rem;
            color: var(--text-sub);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .card-value {
            font-size: 2rem;
            font-weight: bold;
            margin: 10px 0 5px 0;
        }

        .unit { font-size: 1rem; color: var(--text-sub); }

        /* Chart Section */
        .chart-section {
            background-color: var(--card-bg);
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 25px;
        }

        .chart-container {
            position: relative;
            height: 300px;
            width: 100%;
        }

        /* Hardware Simulation Control Panel */
        .control-panel {
            background-color: var(--card-bg);
            padding: 20px;
            border-radius: 12px;
        }

        .control-panel h3 {
            margin-top: 0;
            color: var(--accent-blue);
        }

        .slider-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 15px;
        }

        .slider-group label {
            display: block;
            margin-bottom: 8px;
            font-size: 0.85rem;
        }

        input[type="range"] {
            width: 100%;
            cursor: pointer;
        }
    </style>
</head>
<body>

    <header>
        <h1>☀️ IoT Solar Panel Performance Dashboard</h1>
        <div class="connection-badge" id="conn-status">SYSTEM ONLINE</div>
    </header>

    <!-- Key Solar Metrics -->
    <div class="metrics-grid">
        <div class="card">
            <div class="card-title">Panel Voltage</div>
            <div class="card-value"><span id="val-voltage">18.2</span> <span class="unit">V</span></div>
        </div>

        <div class="card">
            <div class="card-title">Panel Current</div>
            <div class="card-value"><span id="val-current">4.50</span> <span class="unit">A</span></div>
        </div>

        <div class="card power">
            <div class="card-title">Power Output</div>
            <div class="card-value"><span id="val-power">81.9</span> <span class="unit">W</span></div>
        </div>

        <div class="card temp">
            <div class="card-title">Panel Temperature</div>
            <div class="card-value"><span id="val-temp">35.0</span> <span class="unit">°C</span></div>
        </div>

        <div class="card efficiency">
            <div class="card-title">Calculated Efficiency</div>
            <div class="card-value"><span id="val-efficiency">82</span> <span class="unit">%</span></div>
        </div>
    </div>

    <!-- Time Series Power Graph -->
    <div class="chart-section">
        <h3 style="margin-top:0; font-size:1.1rem;">Live Power Output (Watts)</h3>
        <div class="chart-container">
            <canvas id="powerChart"></canvas>
        </div>
    </div>

    <!-- Simulation Controls -->
    <div class="control-panel">
        <h3>Hardware Parameter Simulation (Test Sliders)</h3>
        <div class="slider-grid">
            <div class="slider-group">
                <label>Voltage (V): <strong id="slide-v-val">18.2</strong></label>
                <input type="range" id="slider-voltage" min="0" max="25" step="0.1" value="18.2" oninput="updateDashboard()">
            </div>

            <div class="slider-group">
                <label>Current (A): <strong id="slide-i-val">4.50</strong></label>
                <input type="range" id="slider-current" min="0" max="10" step="0.05" value="4.50" oninput="updateDashboard()">
            </div>

            <div class="slider-group">
                <label>Panel Temperature (°C): <strong id="slide-t-val">35.0</strong></label>
                <input type="range" id="slider-temp" min="10" max="80" step="0.5" value="35.0" oninput="updateDashboard()">
            </div>
        </div>
    </div>

    <script>
        // Chart initialization
        const ctx = document.getElementById('powerChart').getContext('2d');
        const maxDataPoints = 15;
        
        const powerChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: [],
                datasets: [{
                    label: 'Solar Power (W)',
                    data: [],
                    borderColor: '#f59e0b',
                    backgroundColor: 'rgba(245, 158, 11, 0.1)',
                    fill: true,
                    tension: 0.3,
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    x: { grid: { color: '#1e293b' }, ticks: { color: '#94a3b8' } },
                    y: { grid: { color: '#1e293b' }, ticks: { color: '#94a3b8' }, beginAtZero: true }
                },
                plugins: {
                    legend: { labels: { color: '#f1f5f9' } }
                }
            }
        });

        function updateDashboard() {
            const voltage = parseFloat(document.getElementById('slider-voltage').value);
            const current = parseFloat(document.getElementById('slider-current').value);
            const temp = parseFloat(document.getElementById('slider-temp').value);

            // Update display sliders text
            document.getElementById('slide-v-val').innerText = voltage.toFixed(1);
            document.getElementById('slide-i-val').innerText = current.toFixed(2);
            document.getElementById('slide-t-val').innerText = temp.toFixed(1);

            // Calculate Power & Efficiency (Base max rating = 100W at STC)
            const power = voltage * current;
            let efficiency = (power / 100) * 100; 
            
            // Temperature derating factor (-0.4% per °C above 25°C standard)
            if (temp > 25) {
                efficiency -= (temp - 25) * 0.4;
            }
            efficiency = Math.max(0, Math.min(100, efficiency)); // Keep between 0-100%

            // Update UI elements
            document.getElementById('val-voltage').innerText = voltage.toFixed(1);
            document.getElementById('val-current').innerText = current.toFixed(2);
            document.getElementById('val-power').innerText = power.toFixed(1);
            document.getElementById('val-temp').innerText = temp.toFixed(1);
            document.getElementById('val-efficiency').innerText = efficiency.toFixed(0);
        }

        // Live Periodic Graph Update
        setInterval(() => {
            const currentPower = parseFloat(document.getElementById('val-power').innerText);
            const now = new Date();
            const timeLabel = now.getHours().toString().padStart(2, '0') + ':' + 
                              now.getMinutes().toString().padStart(2, '0') + ':' + 
                              now.getSeconds().toString().padStart(2, '0');

            if (powerChart.data.labels.length >= maxDataPoints) {
                powerChart.data.labels.shift();
                powerChart.data.datasets[0].data.shift();
            }

            powerChart.data.labels.push(timeLabel);
            powerChart.data.datasets[0].data.push(currentPower);
            powerChart.update();
        }, 2000);

        // Initial setup on page load
        updateDashboard();
    </script>
</body>
</html>
